<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="TopBar" style="flex-grow: 1; width: 100%; height: 10%; position: absolute; background-color: rgba(0, 0, 0, 0.33);">
        <ui:VisualElement name="goldCounter" style="flex-grow: 1; width: 10%; height: 50%; position: absolute; left: 11%; top: 26%; right: 0; bottom: 0; font-size: 14%; background-color: rgba(0, 0, 0, 0.5); border-top-left-radius: 32%; border-top-right-radius: 32%; border-bottom-right-radius: 32%; border-bottom-left-radius: 32%;">
            <ui:VisualElement name="gold-icon" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/UI/Scripts/Icons/UICoin.png?fileID=2800000&amp;guid=c2c1f98c1edc0564894c5bb7614b88e4&amp;type=3#UICoin&quot;); width: 34%; height: 100%; position: absolute;" />
            <ui:Label tabindex="-1" text="Gold: 0" parse-escape-sequences="true" display-tooltip-when-elided="true" name="gold-label" style="position: absolute; left: 32%; width: 34%; height: 67%; color: rgb(255, 255, 255); font-size: 24%; top: 7%;" />
        </ui:VisualElement>
        <ui:VisualElement name="seedCounter" style="flex-grow: 1; width: 10%; height: 50%; position: absolute; left: 23%; top: 26%; right: 0; bottom: 0; font-size: 14%; background-color: rgba(0, 0, 0, 0.5); border-top-left-radius: 32%; border-top-right-radius: 32%; border-bottom-right-radius: 32%; border-bottom-left-radius: 32%;">
            <ui:VisualElement name="seed-icon" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/UI/Scripts/Icons/UISeed.png?fileID=2800000&amp;guid=50bb00c9ae0699643a20b1cebe70631f&amp;type=3#UISeed&quot;); width: 34%; height: 100%; position: absolute;" />
            <ui:Label tabindex="-1" text="Seeds: 0" parse-escape-sequences="true" display-tooltip-when-elided="true" name="seed-label" style="position: absolute; left: 32%; width: 34%; height: 67%; color: rgb(255, 255, 255); font-size: 22%; top: 7%;" />
        </ui:VisualElement>
        <ui:Button text="=" parse-escape-sequences="true" display-tooltip-when-elided="true" name="menu-button" style="position: absolute; left: 2%; top: 18%; width: 6%; height: 62%; font-size: 83%; border-top-left-radius: 36%; border-top-right-radius: 36%; border-bottom-right-radius: 36%; border-bottom-left-radius: 36%; background-color: rgba(38, 38, 38, 0.75); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); color: rgb(255, 255, 255); -unity-text-align: middle-center;" />
    </ui:VisualElement>
    <ui:VisualElement name="BottomBar" style="flex-grow: 1; width: 100%; height: 5%; position: absolute; background-color: rgba(0, 0, 0, 0.33); left: 0; top: 95%; right: 0; bottom: 0;" />
    <ui:VisualElement name="menuPopup" style="flex-grow: 1; position: absolute; left: 37%; top: 15%; width: 26%; height: 70%; background-color: rgba(0, 0, 0, 0.34); border-top-left-radius: 19%; border-top-right-radius: 19%; border-bottom-right-radius: 19%; border-bottom-left-radius: 19%; right: 0; bottom: 0;">
        <ui:Label tabindex="-1" text="PAUSED" parse-escape-sequences="true" display-tooltip-when-elided="true" name="pauselabel" style="position: absolute; font-size: 73%; left: 20%; top: 3%; color: rgb(255, 255, 255); -unity-text-align: middle-left;" />
        <ui:Button text="continue" parse-escape-sequences="true" display-tooltip-when-elided="true" name="continue-button" style="position: absolute; left: 10%; width: 80%; height: 20%; top: 30%; border-top-left-radius: 35%; border-top-right-radius: 35%; border-bottom-right-radius: 35%; border-bottom-left-radius: 35%; font-size: 64%; color: rgb(255, 255, 255); background-color: rgb(55, 55, 55); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0);" />
        <ui:Button text="main menu" parse-escape-sequences="true" display-tooltip-when-elided="true" name="main-menu-button" style="position: absolute; left: 10%; width: 80%; height: 20%; top: 60%; border-top-left-radius: 35%; border-top-right-radius: 35%; border-bottom-right-radius: 35%; border-bottom-left-radius: 35%; font-size: 64%; color: rgb(255, 255, 255); background-color: rgb(55, 55, 55); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0);" />
    </ui:VisualElement>
</ui:UXML>
